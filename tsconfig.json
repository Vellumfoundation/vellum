{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "bridge/superbridge/validation/**/*.ts",
    "bridge/scripts/**/*.ts",
    "monitoring/scripts/**/*.ts",
    "tests/e2e/**/*.ts"
  ]
}
