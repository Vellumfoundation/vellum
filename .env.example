# General
PROJECT_ENV=development
VELLUM_NAME="Vellum"
VELLUM_CHAIN_ID=90103
VELLUM_CHAIN_ID_HEX=0x15ff7
VELLUM_CHAIN_SLUG=vellum

# Parent chain
PARENT_CHAIN_NAME=Base
PARENT_CHAIN_ID=8453
PARENT_RPC_URL=
PARENT_WS_URL=

# Public testnet deployment secrets.
# Store real values in a secret manager, not in a committed env file.
TESTNET_DEPLOYER_PRIVATE_KEY=
TESTNET_BATCHER_PRIVATE_KEY=
TESTNET_PROPOSER_PRIVATE_KEY=
TESTNET_SEQUENCER_PRIVATE_KEY=
TESTNET_READINESS_REQUIRE_SECRETS=0
TESTNET_READINESS_LIVE=0

# Public testnet artifact import.
TESTNET_ARTIFACT_DIR=chain/testnet/artifacts
TESTNET_DEPLOYER_WORKDIR=chain/testnet/deployer
TESTNET_PUBLIC_RPC_URL=
TESTNET_WS_RPC_URL=
TESTNET_EXPLORER_URL=
TESTNET_STATUS_URL=
TESTNET_WITHDRAWAL_CHALLENGE_PERIOD_SECONDS=
TESTNET_BRAND_ICON_URL=
TESTNET_BRAND_LOGO_URL=
TESTNET_L3_MULTICALL3_ADDRESS=

# Local devnet parent simulator
DEVNET_L1_CHAIN_ID=11155111
DEVNET_L1_RPC_URL=http://127.0.0.1:9545
DEVNET_L1_RPC_URL_DOCKER=http://host.docker.internal:9545
DEVNET_L1_BEACON_URL_DOCKER=http://host.docker.internal:9545
DEVNET_L2_CHAIN_ID=90103
DEVNET_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEVNET_FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:stable
OP_GETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-geth:v1.101702.1
OP_NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.17.0
OP_BATCHER_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-batcher:v1.16.7
OP_PROPOSER_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-proposer:v1.16.2

# L3 RPC
VELLUM_RPC_URL=http://localhost:8545
VELLUM_WS_URL=ws://localhost:8546
VELLUM_PRIVATE_RPC_URL=http://localhost:9545

# Native currency
NATIVE_CURRENCY_NAME=Ether
NATIVE_CURRENCY_SYMBOL=ETH
NATIVE_CURRENCY_DECIMALS=18

# Explorer
EXPLORER_URL=http://localhost:4000
EXPLORER_API_URL=http://localhost:4000/api

# Status service
STATUS_PORT=8787
STATUS_RPC_URL=
STATUS_WS_URL=
STATUS_EXPLORER_URL=
STATUS_BRIDGE_URL=
STATUS_FAUCET_URL=
STATUS_DOCS_URL=
STATUS_REQUEST_TIMEOUT_MS=5000

# Docs service
DOCS_PORT=3003
DOCS_SOURCE_DIR=docs

# Testnet faucet service
TESTNET_FAUCET_ENABLED=false
FAUCET_PORT=8788
FAUCET_RPC_URL=
FAUCET_AMOUNT_ETH=0.01
FAUCET_WALLET_COOLDOWN_SECONDS=86400
FAUCET_IP_COOLDOWN_SECONDS=3600
FAUCET_DAILY_BUDGET_ETH=1
FAUCET_CORS_ORIGIN=*

# Bridge
BRIDGE_TYPE=op-stack-canonical
BRIDGE_METADATA_OUTPUT=bridge/superbridge
WITHDRAWAL_CHALLENGE_PERIOD_SECONDS=

# Contract addresses
PARENT_PORTAL_ADDRESS=
PARENT_STANDARD_BRIDGE_ADDRESS=
PARENT_CROSS_DOMAIN_MESSENGER_ADDRESS=
PARENT_SYSTEM_CONFIG_ADDRESS=
PARENT_OUTPUT_ORACLE_ADDRESS=
PARENT_DISPUTE_GAME_FACTORY_ADDRESS=
L3_STANDARD_BRIDGE_ADDRESS=
L3_CROSS_DOMAIN_MESSENGER_ADDRESS=
L3_MULTICALL3_ADDRESS=

# RPC Gateway
RPC_GATEWAY_PORT=8080
RPC_RATE_LIMIT_PER_MINUTE=120
RPC_MAX_GET_LOGS_BLOCK_RANGE=5000
RPC_ADMIN_METHODS_ENABLED=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vellum
REDIS_URL=redis://localhost:6379

# Monitoring
PROMETHEUS_PORT=9090
METRICS_PORT=9100
GRAFANA_PORT=3001
ALERT_WEBHOOK_URL=

# Test keys only
DEVNET_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
TESTNET_FAUCET_PRIVATE_KEY=
SYNTHETIC_MONITOR_PRIVATE_KEY=

# Production secrets should come from secret manager, not .env
