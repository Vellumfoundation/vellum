[Unit]
Description=Vellum Testnet Status Service
After=network-online.target
Wants=network-online.target

[Service]
User=vellum
WorkingDirectory=/opt/vellum
EnvironmentFile=-/etc/vellum/testnet.env
Environment=STATUS_PORT=8787
ExecStart=/usr/bin/pnpm status:start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
