[Unit]
Description=Vellum Testnet Docs Site
After=network-online.target
Wants=network-online.target

[Service]
User=vellum
WorkingDirectory=/opt/vellum
EnvironmentFile=-/etc/vellum/testnet.env
Environment=DOCS_PORT=3003
ExecStart=/usr/bin/node /opt/vellum/apps/docs-site/src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
